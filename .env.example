APP_NAME="Yaman Warda"

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
BASE_URL=http://localhost:3000

# Local database (compose.yaml). Keep this file: `bun run db:up` is how the
# project runs on this machine. It has nothing to do with where the site is
# hosted.
POSTGRES_DB=personal_platform
POSTGRES_USER=platform
POSTGRES_PASSWORD=
POSTGRES_PORT=5433

# Locally this points at the container above. In production it is the Neon
# POOLED connection string (the host contains `-pooler`), EU region, with
# `?sslmode=require`. Plain PostgreSQL either way, per D22 — so the same
# string shape works on a server later.
DATABASE_URL=postgresql://platform:<password>@127.0.0.1:5433/personal_platform

# Used only by `bun run db:seed:admin`
ADMIN_NAME="Yaman Warda"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Added in later blocks
RESEND_API_KEY=
EMAIL_FROM=
CONTACT_TO_EMAIL=

# Cloudflare R2 — the image store
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Signs draft-preview links. Generate with: openssl rand -base64 32
PREVIEW_TOKEN_SECRET=

# ---------------------------------------------------------------------------
# Production (Cloudflare Workers, D22)
#
# Nothing here belongs in this file with a real value — these are set once as
# encrypted secrets and never committed:
#
#   bunx wrangler secret put BETTER_AUTH_SECRET
#   bunx wrangler secret put DATABASE_URL
#   bunx wrangler secret put BASE_URL
#   bunx wrangler secret put BETTER_AUTH_URL
#   ... and the same for every value above that is not blank locally.
#
# Non-secret values live in `wrangler.jsonc` under `vars`.
#
# BASE_URL and BETTER_AUTH_URL are https://yamanwarda.de in production, and
# the staging hostname while the CPU budget is being measured.

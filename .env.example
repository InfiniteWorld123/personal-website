APP_NAME="Yaman Warda"

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
BASE_URL=http://localhost:3000

# Local database (compose.yaml)
POSTGRES_DB=personal_platform
POSTGRES_USER=platform
POSTGRES_PASSWORD=
POSTGRES_PORT=5433
DATABASE_URL=postgresql://platform:<password>@127.0.0.1:5433/personal_platform

# Used only by `bun run db:seed:admin`
ADMIN_NAME="Yaman Warda"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Added in later blocks
RESEND_API_KEY=
EMAIL_FROM=
CONTACT_TO_EMAIL=

# Cloudflare R2 — the image store
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Signs draft-preview links. Generate with: openssl rand -base64 32
PREVIEW_TOKEN_SECRET=

APP_NAME="Yaman Warda"

# The site's own origin, used for links in V2 emails and payment pages when
# AUTH_V2_ORIGIN is not set.
BASE_URL=http://localhost:3000

# Turnstile's public site key is safe in the browser; the secret is server-only.
# The values below are Cloudflare's official always-pass development keys.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ---------------------------------------------------------------------------
# Backend2 (V2), the site's only backend since 24 Sep 2026.
#
# DATABASE_URL_V2 is the V2 database (Neon, Frankfurt). The client and the
# migration runner both refuse to start when it is missing. The legacy
# database's DATABASE_URL is no longer used by any code; while it is still set
# somewhere, the client also refuses a DATABASE_URL_V2 equal to it.
DATABASE_URL_V2=

# Opens the owner-only Backend2 API. Development only: it is absent by default,
# it is never written into wrangler.jsonc, and it is never set as a Worker
# secret. Without it those routes are not even registered.
BACKEND2_OWNER_API=local

# Optional. A throwaway database for the integration suite. The tests refuse to
# run when it equals DATABASE_URL_V2. Leave it blank and the suite uses PGlite
# in-process instead, which needs no database at all.
DATABASE_URL_V2_TEST=

# ---------------------------------------------------------------------------
# Auth V2 (docs/v2/auth.md), the Dashboard's only sign-in.
#
# AUTH_V2_SECRET encrypts the TOTP secret at rest and keys the rate-limit and
# address hashes. Changing it invalidates every stored authenticator secret,
# so treat it as permanent. Generate with: openssl rand -base64 32
# Off production it falls back to a fixed development value.
AUTH_V2_SECRET=

# The WebAuthn Relying Party ID: a registrable domain, with no scheme and no
# port (yamanwarda.de). A passkey registered under one RP ID cannot be used
# under another, so this is effectively permanent too. Defaults to `localhost`
# off production; required in production.
AUTH_V2_RP_ID=

# The exact origin(s) a passkey assertion must claim, comma-separated, with a
# scheme and no trailing path. Passkeys need HTTPS everywhere except
# localhost. Also the origin used for links in password-reset and
# email-change messages. Required in production.
AUTH_V2_ORIGIN=

# ---------------------------------------------------------------------------
# Shared Media V2 (docs/v2/media.md). There is deliberately nothing to set.
#
# The vault needs no R2 access key, no secret and no credential: on Cloudflare
# it uses an R2 *binding* named MEDIA_V2, and locally it writes to
# .backend2-media/ (gitignored). There is no signed-S3 driver in V2, so there
# is nothing here to leak.
#
# Both setup steps are DONE as of 22 Sep 2026:
#   1. the private bucket `yamanwarda-v2-media` exists in Cloudflare, in
#      Western Europe, with its public r2.dev URL switched OFF — and it must
#      stay off, because the library is private and the only way a file
#      reaches a visitor is the application's own checked route; and
#   2. wrangler.jsonc carries the binding `MEDIA_V2`.
#
# Verified by writing an object to the real bucket, reading it back and
# deleting it. What that does NOT prove is the binding arriving inside a
# running Worker, which only happens at deploy — and nothing has been
# deployed.
#
# Local development uses neither: `bun run dev` writes to .backend2-media/.
# If the binding is ever removed or renamed, a deployed upload answers
# 503 STORAGE_UNAVAILABLE rather than pretending to have stored anything.
#
# `bun run db2:media:sweep` finishes object deletions a crash interrupted. It
# never deletes a file merely because nothing references it — an unused file in
# the library is one the owner kept.

# Makes the Projects and media owner routes demand a V2 owner session on top
# of the local-only fence. Absent by default, which leaves the fence exactly
# as it was. Turning it on strictly adds a requirement; it can never remove
# one. This is the "switch to V2 session authorization" step, and it belongs
# to its own reviewed change once the frontend sign-in exists.
BACKEND2_OWNER_AUTH=

# Email through Resend (sign-in messages, booking and Inbox mail).
RESEND_API_KEY=
EMAIL_FROM=

# Inbox V2 (docs/v2/inbox.md). INBOX_INGRESS_SECRET turns on
# POST /api/v2/inbound-email; the same value is a secret on the
# `yamanwarda-inbound-email` Worker. At least 32 characters:
#   openssl rand -hex 32
# INBOX_SEND_MODE=live makes V2 email real through Resend (RESEND_API_KEY);
# anything else is a fake send locally and an honest failure in production.
# The two addresses default to info@ and reply@ (reply+<token>@) yamanwarda.de.
INBOX_INGRESS_SECRET=
INBOX_SEND_MODE=
INBOX_FROM_ADDRESS=
INBOX_REPLY_ADDRESS=

# ---------------------------------------------------------------------------
# Production (Cloudflare Workers, D22)
#
# Nothing here belongs in this file with a real value — these are set once as
# encrypted secrets and never committed:
#
#   bunx wrangler secret put DATABASE_URL_V2
#   bunx wrangler secret put AUTH_V2_SECRET
#   bunx wrangler secret put TURNSTILE_SECRET_KEY
#   bunx wrangler secret put RESEND_API_KEY
#   bunx wrangler secret put INBOX_INGRESS_SECRET
#   ... and the same for every value above that is not blank locally.
#
# Non-secret values live in `wrangler.jsonc` under `vars`.
#
# BASE_URL is https://yamanwarda.de in production.

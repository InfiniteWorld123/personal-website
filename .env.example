APP_NAME="Yaman Warda"

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
BASE_URL=http://localhost:3000

# Turnstile's public site key is safe in the browser; the secret is server-only.
# The values below are Cloudflare's official always-pass development keys.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Generate independently with: openssl rand -base64 32
RATE_LIMIT_SECRET=

# The Neon POOLED connection string (the host contains `-pooler`), EU region,
# with `?sslmode=require`. The same string is used for local development and
# in production — there is no local database. Plain PostgreSQL either way,
# per D22, so the same string shape works on a server later.
DATABASE_URL=postgresql://<user>:<password>@<host>-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# ---------------------------------------------------------------------------
# Backend2 (V2). Its own database, never the legacy one.
#
# DATABASE_URL_V2 must point at a SEPARATE PostgreSQL database. The client and
# the migration runner both refuse to start when it is missing, and when it is
# the same string as DATABASE_URL — a typo there would let V2 write into tables
# the foundation says it may never touch.
DATABASE_URL_V2=

# Opens the owner-only Backend2 API. Development only: it is absent by default,
# it is never written into wrangler.jsonc, and it is never set as a Worker
# secret. Without it those routes are not even registered.
BACKEND2_OWNER_API=local

# Optional. A throwaway database for the integration suite. The tests refuse to
# run when it equals DATABASE_URL or DATABASE_URL_V2. Leave it blank and the
# suite uses PGlite in-process instead, which needs no database at all.
DATABASE_URL_V2_TEST=

# ---------------------------------------------------------------------------
# Auth V2 (docs/v2/auth.md). Its own secret, never BETTER_AUTH_SECRET: the
# legacy backend has to stay deletable at cutover without taking V2's stored
# secrets with it.
#
# AUTH_V2_SECRET encrypts the TOTP secret at rest and keys the rate-limit and
# address hashes. Changing it invalidates every stored authenticator secret,
# so treat it as permanent. Generate with: openssl rand -base64 32
# Off production it falls back to a fixed development value.
AUTH_V2_SECRET=

# The WebAuthn Relying Party ID: a registrable domain, with no scheme and no
# port (yamanwarda.de). A passkey registered under one RP ID cannot be used
# under another, so this is effectively permanent too. Defaults to `localhost`
# off production; required in production.
AUTH_V2_RP_ID=

# The exact origin(s) a passkey assertion must claim, comma-separated, with a
# scheme and no trailing path. Passkeys need HTTPS everywhere except
# localhost. Also the origin used for links in password-reset and
# email-change messages. Required in production.
AUTH_V2_ORIGIN=

# ---------------------------------------------------------------------------
# Shared Media V2 (docs/v2/media.md). There is deliberately nothing to set.
#
# The vault needs no R2 access key, no secret and no credential: on Cloudflare
# it uses an R2 *binding* named MEDIA_V2, and locally it writes to
# .backend2-media/ (gitignored). There is no signed-S3 driver in V2, so there
# is nothing here to leak.
#
# Both setup steps are DONE as of 22 Sep 2026:
#   1. the private bucket `yamanwarda-v2-media` exists in Cloudflare, in
#      Western Europe, with its public r2.dev URL switched OFF — and it must
#      stay off, because the library is private and the only way a file
#      reaches a visitor is the application's own checked route; and
#   2. wrangler.jsonc carries the binding `MEDIA_V2` beside the legacy MEDIA.
#
# Verified by writing an object to the real bucket, reading it back and
# deleting it. What that does NOT prove is the binding arriving inside a
# running Worker, which only happens at deploy — and nothing has been
# deployed.
#
# Local development uses neither: `bun run dev` writes to .backend2-media/.
# If the binding is ever removed or renamed, a deployed upload answers
# 503 STORAGE_UNAVAILABLE rather than pretending to have stored anything.
#
# `bun run db2:media:sweep` finishes object deletions a crash interrupted. It
# never deletes a file merely because nothing references it — an unused file in
# the library is one the owner kept.

# Makes the Projects and media owner routes demand a V2 owner session on top
# of the local-only fence. Absent by default, which leaves the fence exactly
# as it was. Turning it on strictly adds a requirement; it can never remove
# one. This is the "switch to V2 session authorization" step, and it belongs
# to its own reviewed change once the frontend sign-in exists.
BACKEND2_OWNER_AUTH=

# Used only by `bun run db:seed:admin`
ADMIN_NAME="Yaman Warda"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Added in later blocks
RESEND_API_KEY=
EMAIL_FROM=
CONTACT_TO_EMAIL=

# Inbound replies into the admin inbox (B4). The address must carry a `+`:
# the per-lead token is written into that slot, e.g. reply+abc123@yamanwarda.de.
# Without both, the inbox still stores, notifies, and sends — it just cannot
# take an answer back. Generate the secret with: openssl rand -base64 32
INBOUND_MAIL_ADDRESS=
INBOUND_MAIL_SECRET=

# Cloudflare R2 — the image store
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Signs draft-preview links. Generate with: openssl rand -base64 32
PREVIEW_TOKEN_SECRET=

# ---------------------------------------------------------------------------
# The video call inside a booking (D33)
#
# CALL_ROOM_SECRET is shared with workers/call-room. Set the same value in
# both places or the room is one nobody can enter:
#   openssl rand -base64 32
#   bunx wrangler secret put CALL_ROOM_SECRET --config workers/call-room/wrangler.jsonc
#
# CALL_ROOM_URL is that Worker's address, wss:// in production and
# ws://127.0.0.1:8787 while it runs locally.
#
# TURN_* come from Cloudflare: Realtime -> TURN Keys. Free for the first
# 1,000 GB a month. Leave them blank and calls still connect for most people.
CALL_ROOM_SECRET=
CALL_ROOM_URL=
TURN_KEY_ID=
TURN_KEY_API_TOKEN=

# The public assistant (D34). Unset means CHAT_PROVIDER=off: it answers from
# src/backend/modules/chat/chat.knowledge.ts with no key and no network call.
# Renting a model is two lines. Before doing it on a client's site, note that
# free tiers generally train on what they are sent and carry no AVV.
CHAT_PROVIDER=off
CHAT_API_KEY=
CHAT_MODEL=

# ---------------------------------------------------------------------------
# Production (Cloudflare Workers, D22)
#
# Nothing here belongs in this file with a real value — these are set once as
# encrypted secrets and never committed:
#
#   bunx wrangler secret put BETTER_AUTH_SECRET
#   bunx wrangler secret put TURNSTILE_SECRET_KEY
#   bunx wrangler secret put RATE_LIMIT_SECRET
#   bunx wrangler secret put DATABASE_URL
#   bunx wrangler secret put BASE_URL
#   bunx wrangler secret put BETTER_AUTH_URL
#   ... and the same for every value above that is not blank locally.
#
# Non-secret values live in `wrangler.jsonc` under `vars`.
#
# BASE_URL and BETTER_AUTH_URL are https://yamanwarda.de in production, and
# the staging hostname while the CPU budget is being measured.

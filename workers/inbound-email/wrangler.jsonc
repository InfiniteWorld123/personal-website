{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yamanwarda-inbound-email",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-15",

  // The endpoint is public information; the shared secret is not, and is set
  // once with: bunx wrangler secret put INBOUND_MAIL_SECRET
  "vars": {
    "INBOUND_ENDPOINT": "https://yamanwarda.de/api/inbound-email"
  }
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yamanwarda",
  "compatibility_date": "2026-09-13",

  // `pg`, `AsyncLocalStorage` and the V2 sign-in's crypto need the Node
  // compatibility layer. Nitro adds this flag on its own when it writes
  // the deployed config; it is stated here so the value is visible in the repo.
  "compatibility_flags": ["nodejs_compat"],

  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  },

  // Off since the domain went live on 11 Sep 2026. A `*.workers.dev` address
  // would be a second, crawlable copy of the whole site competing with it in
  // search. Set it back to `true` only to reach the Worker while the domain
  // itself is broken — and turn it off again afterwards.
  "workers_dev": false,

  // The site answers on the domain itself, not only on `*.workers.dev`.
  // `custom_domain` makes Cloudflare own the DNS record and the certificate
  // for each hostname; there is nothing to add by hand in the DNS panel.
  //
  // `zone_name` is not optional here: the zone is still pending activation, so
  // Wrangler cannot infer it from the hostname and the deploy half-fails.
  "routes": [
    { "pattern": "yamanwarda.de", "custom_domain": true, "zone_name": "yamanwarda.de" },
    { "pattern": "www.yamanwarda.de", "custom_domain": true, "zone_name": "yamanwarda.de" }
  ],

  // Cloudflare holds the PostgreSQL connection pool outside the Worker.
  // A Worker may not reuse a socket between requests, so the application
  // opens a connection per request; Hyperdrive is what makes that cheap
  // instead of a fresh TLS handshake to Frankfurt every time.
  "hyperdrive": [
    // V2's database (Neon, Frankfurt), caching off. The legacy connection
    // (`HYPERDRIVE`) went with the legacy backend on 24 Sep 2026.
    {
      "binding": "HYPERDRIVE_V2",
      "id": "eb58d725f53141a0abdebe3ffb5a51b3"
    }
  ],

  // Backend2's periodic jobs (`src/backend2/jobs/scheduled.ts`): blog
  // schedules and booking reminders every tick; billing, purge and sweeps on
  // the :00 tick. Every 15 minutes so Neon can sleep between runs.
  "triggers": { "crons": ["*/15 * * * *"] },

  // The V2 media bucket, handed to the Worker directly: no access key to
  // create, store or leak. Created 22 Sep 2026 in Western Europe. Its public
  // `r2.dev` URL is switched OFF and must stay off — the one way a file
  // reaches a visitor is the application's own route, which checks on every
  // request that a published page still uses it. (The legacy `MEDIA` bucket
  // left with the legacy backend on 24 Sep 2026.)
  //
  // `MEDIA_V2` is the name `src/backend2/media/store.r2-binding.ts` looks for.
  // Renaming it here silently disables deployed storage: the code would find
  // no bucket and answer "storage unavailable" rather than fail loudly.
  "r2_buckets": [
    {
      "binding": "MEDIA_V2",
      "bucket_name": "yamanwarda-v2-media"
    }
  ],

  // `main` and `assets` are filled in by Nitro at build time from the preset —
  // do not set them here, they would be ignored with a warning.

  // Secrets are never written in this file. They are set once per environment:
  //   npx wrangler secret put AUTH_V2_SECRET
  // and are listed in `.env.example`.
  "vars": {
    "APP_NAME": "Yaman Warda",

    // Since the V2 cutover (24 Sep 2026): the Dashboard at
    // yamanwarda.de/dashboard, behind the V2 sign-in (password + authenticator code, or a passkey).
    // Owner routes answer only on this exact host, not on www.
    "BACKEND2_OWNER_API": "remote",
    "AUTH_V2_ORIGIN": "https://yamanwarda.de",
    "AUTH_V2_RP_ID": "yamanwarda.de",

    // Real email from V2 (booking confirmations and reminders, Inbox replies)
    // through Resend. Invoices stay in test mode: INVOICES_LIVE_ENABLED is
    // deliberately absent until the owner turns real payments on.
    "INBOX_SEND_MODE": "live",

    // Cookieless Cloudflare Web Analytics. The beacon token is public (it is
    // printed in every page); the Dashboard reads the numbers with the secret
    // CF_ANALYTICS_API_TOKEN.
    "CF_WEB_ANALYTICS_TOKEN": "9e78c46c11c24493a6164659195c1177",
    "CF_ACCOUNT_ID": "9e77752659ea97f8c387249ac9fbeee1",
    "CF_WEB_ANALYTICS_SITE_TAG": "9f7927267754453da9225c4fab37f78b"
  }
}

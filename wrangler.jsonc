{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yamanwarda",
  "compatibility_date": "2026-09-13",

  // `pg`, `AsyncLocalStorage`, and the crypto used by Better Auth all need the
  // Node compatibility layer. Nitro adds this flag on its own when it writes
  // the deployed config; it is stated here so the value is visible in the repo.
  "compatibility_flags": ["nodejs_compat"],

  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  },

  // Off since the domain went live on 11 Sep 2026. A `*.workers.dev` address
  // would be a second, crawlable copy of the whole site competing with it in
  // search. Set it back to `true` only to reach the Worker while the domain
  // itself is broken — and turn it off again afterwards.
  "workers_dev": false,

  // The site answers on the domain itself, not only on `*.workers.dev`.
  // `custom_domain` makes Cloudflare own the DNS record and the certificate
  // for each hostname; there is nothing to add by hand in the DNS panel.
  //
  // `zone_name` is not optional here: the zone is still pending activation, so
  // Wrangler cannot infer it from the hostname and the deploy half-fails.
  "routes": [
    { "pattern": "yamanwarda.de", "custom_domain": true, "zone_name": "yamanwarda.de" },
    { "pattern": "www.yamanwarda.de", "custom_domain": true, "zone_name": "yamanwarda.de" }
  ],

  // Cloudflare holds the PostgreSQL connection pool outside the Worker.
  // A Worker may not reuse a socket between requests, so the application
  // opens a connection per request; Hyperdrive is what makes that cheap
  // instead of a fresh TLS handshake to Frankfurt every time.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "ff94beb83ae744a38526c880364ac7a9"
    }
  ],

  // The media bucket, handed to the Worker directly.
  //
  // A binding rather than S3 credentials: a Worker that declares the bucket is
  // given it, with no access key to create in the dashboard, none to store in
  // an environment variable, and none to leak. Client attachments are served
  // back through an admin-guarded route, so the bucket also stays private —
  // its public `r2.dev` URL is switched off and should stay off.
  //
  // The signed S3 driver is still in the code for the Node dev server, which
  // has no bindings; without keys there, files simply cannot be stored locally.
  // The V2 bucket sits beside it, and stays separate on purpose: the two
  // systems have to be deletable independently, so nothing V2 writes ever
  // lands among the legacy files.
  //
  // Created 22 Sep 2026 in Western Europe, like the one above. Its public
  // `r2.dev` URL is switched OFF and must stay off — the shared library is
  // private, and the one way a file reaches a visitor is the application's own
  // route, which checks on every request that a published page still uses it.
  //
  // `MEDIA_V2` is the name `src/backend2/media/store.r2-binding.ts` looks for.
  // Renaming it here silently disables deployed storage: the code would find
  // no bucket and answer "storage unavailable" rather than fail loudly.
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "yamanwarda-media"
    },
    {
      "binding": "MEDIA_V2",
      "bucket_name": "yamanwarda-v2-media"
    }
  ],

  // `main` and `assets` are filled in by Nitro at build time from the preset —
  // do not set them here, they would be ignored with a warning.

  // Secrets are never written in this file. They are set once per environment:
  //   bunx wrangler secret put BETTER_AUTH_SECRET
  // and are listed in `.env.example`.
  "vars": {
    "APP_NAME": "Yaman Warda"
  }
}

{
  "name": "personal-website",
  "private": true,
  "packageManager": "bun@1.3.14",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "build:cf": "NITRO_PRESET=cloudflare-module vite build",
    "deploy": "bun run build:cf && wrangler deploy",
    "dev:cf": "bun run build:cf && cp .env .output/server/.dev.vars && CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=$(grep '^DATABASE_URL=' .env | cut -d= -f2-) wrangler dev --config .output/server/wrangler.json --port 8788 --local",
    "cf:tail": "wrangler tail",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate": "bun src/backend/db/migrate.ts",
    "db2:dev": "bun src/backend2/db/dev-server.ts",
    "db2:migrate": "bun src/backend2/db/migrate.ts",
    "db2:owner:create": "bun src/backend2/db/bootstrap-owner.ts",
    "db2:media:sweep": "bun src/backend2/db/sweep-media.ts",
    "db2:blog:publish-due": "bun src/backend2/db/publish-due-posts.ts",
    "db2:content:export-legacy": "bun src/backend2/db/content-export-legacy.ts",
    "db2:content:import": "bun src/backend2/db/content-import.ts",
    "db:seed:admin": "bun src/backend/db/seed/seed-admin.ts",
    "db:seed:projects": "bun src/backend/db/seed/seed-projects.ts",
    "db:seed:booking": "bun src/backend/db/seed/seed-booking.ts"
  },
  "dependencies": {
    "@elysia/eden": "^1.4.10",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/readex-pro": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@noble/hashes": "^2.4.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@simplewebauthn/browser": "^13",
    "@simplewebauthn/server": "^13",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/router-plugin": "^1.132.0",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "better-auth": "^1.7.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "elysia": "^1.4.30",
    "lucide-react": "^0.545.0",
    "nitro": "npm:nitro-nightly@latest",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "qrcode-generator": "^2.0.4",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shadcn": "^4.2.0",
    "swapy": "^1.0.5",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260915.1",
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "latest",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.4",
    "jsdom": "^28.1.0",
    "postal-mime": "^3.0.0",
    "typescript": "^5.7.2",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.11",
    "wrangler": "^4.131.1"
  }
}
